<template>
	<cl-page>
		<cl-topbar safe-area-top background-color="transparent"></cl-topbar>

		<view class="px-10">
			<!-- Logo -->
			<view class="flex flex-col items-center justify-center py-16">
				<view
					class="p-3 rounded-2xl"
					:class="isDark ? '!bg-surface-800' : '!bg-white'"
				>
					<cl-icon name="money-cny-box-fill" :size="40" color="primary"></cl-icon>
				</view>

				<cl-text :size="20" :pt="{ className: 'font-bold mt-4' }">{{
					config.name
				}}</cl-text>

				<cl-text color="info" :size="12" :pt="{ className: 'mt-2' }">
					家庭财务预算管理
				</cl-text>
			</view>

			<!-- 表单 -->
			<view class="mt-6">
				<cl-input
					v-model="form.username"
					placeholder="请输入用户名"
					prefix-icon="user-line"
					border
					clearable
					:pt="{ className: 'rounded-lg' }"
				></cl-input>

				<cl-input
					v-model="form.password"
					placeholder="请输入密码"
					prefix-icon="lock-line"
					password
					border
					clearable
					:pt="{ className: 'rounded-lg mt-4' }"
				></cl-input>

				<cl-button
					type="primary"
					size="large"
					:loading="loading"
					:pt="{ className: 'mt-8 !rounded-lg' }"
					@tap="toLogin"
				>
					登录
				</cl-button>

				<view class="flex flex-row items-center justify-center mt-6">
					<cl-text color="info" :size="12">默认账号：admin / 123456</cl-text>
				</view>
			</view>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { authApi } from "@/api";
import { setToken, setUser } from "@/api/request";
import { config } from "@/config";
import { isDark, router } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import { reactive, ref } from "vue";

const ui = useUi();

// 表单
const form = reactive<{ username: string; password: string }>({
	username: "admin",
	password: "123456"
});

// 加载中
const loading = ref(false);

// 登录
async function toLogin() {
	if (form.username == "" || form.password == "") {
		ui.showToast({
			message: "请输入用户名和密码"
		});

		return;
	}

	if (loading.value) {
		return;
	}

	loading.value = true;

	try {
		const res = await authApi.login({
			username: form.username,
			password: form.password
		});

		// 保存 token 与用户信息
		setToken(res.access_token);
		setUser(res.user ?? null);

		ui.showToast({
			message: "登录成功"
		});

		// 跳转首页
		router.home();
	} catch (e: any) {
		ui.showToast({
			message: e?.message ?? "登录失败，请检查账号密码"
		});
	} finally {
		loading.value = false;
	}
}
</script>
