<template>
	<cl-footer :pt="{ className: barClass, content: { className: 'px-2' } }">
		<view class="flex flex-row">
			<view
				v-for="item in list"
				:key="item.value"
				class="flex-1 flex flex-col items-center justify-center py-2"
				@tap="onSelect(item)"
			>
				<cl-icon
					:name="isActive(item) ? item.activeIcon : item.icon"
					:size="24"
					:color="isActive(item) ? 'primary' : 'info'"
				></cl-icon>

				<cl-text
					:size="11"
					:color="isActive(item) ? 'primary' : 'info'"
					:pt="{ className: 'mt-1' }"
				>
					{{ item.text }}
				</cl-text>
			</view>
		</view>
	</cl-footer>
</template>

<script setup lang="ts">
import { isDark, router } from "@/.cool";
import { computed } from "vue";

defineOptions({
	name: "custom-tabbar"
});

type TabItem = {
	text: string; // 文案
	value: string; // 页面路径
	icon: string; // 未选中图标
	activeIcon: string; // 选中图标
};

// tabbar 列表（使用 remixicon 矢量图标，无需图片资源，且自动适配深色模式）
const list: TabItem[] = [
	{
		text: "首页",
		value: "pages/index/home",
		icon: "home-line",
		activeIcon: "home-fill"
	},
	{
		text: "收支",
		value: "pages/index/bill",
		icon: "exchange-line",
		activeIcon: "exchange-fill"
	},
	{
		text: "账户",
		value: "pages/index/account",
		icon: "bank-card-line",
		activeIcon: "bank-card-fill"
	},
	{
		text: "我的",
		value: "pages/index/my",
		icon: "user-line",
		activeIcon: "user-fill"
	}
];

// 背景样式（深色模式适配）
const barClass = computed(() => {
	return isDark.value
		? "!bg-surface-900 border-t border-solid !border-surface-700"
		: "!bg-white border-t border-solid !border-surface-100";
});

// 是否选中
function isActive(item: TabItem): boolean {
	return router.path() == item.value;
}

// 切换
function onSelect(item: TabItem) {
	if (isActive(item)) {
		return;
	}

	router.to(item.value);
}

// 隐藏原生 tabBar
// #ifndef MP
uni.hideTabBar();
// #endif
</script>
