<template>
	<cl-page>
		<cl-topbar
			title="我的"
			safe-area-top
			:show-back="false"
		></cl-topbar>

		<view class="p-4">
			<!-- 用户信息 -->
			<view
				class="flex flex-row items-center rounded-2xl p-5"
				:class="isDark ? '!bg-surface-800' : '!bg-surface-100'"
			>
				<cl-avatar
					:size="56"
					rounded
					:pt="{
						icon: {
							size: 30,
							name: 'user-line'
						}
					}"
				></cl-avatar>

				<view class="ml-4 flex-1">
					<cl-text :size="17" :pt="{ className: 'font-bold' }">
						{{ username }}
					</cl-text>
					<cl-text :size="12" color="info" :pt="{ className: 'mt-1' }">
						家庭财务预算管理
					</cl-text>
				</view>
			</view>

			<!-- 功能 -->
			<cl-list border title="功能" :pt="{ className: 'mt-4' }">
				<cl-list-item
					label="个人信息"
					icon="id-card-line"
					arrow
					hoverable
					@tap="toPage('/pages/user/info')"
				></cl-list-item>

				<cl-list-item
					label="账户管理"
					icon="bank-card-line"
					arrow
					hoverable
					@tap="toPage('/pages/index/account')"
				></cl-list-item>

				<cl-list-item
					label="收支管理"
					icon="exchange-line"
					arrow
					hoverable
					@tap="toPage('/pages/index/bill')"
				></cl-list-item>

				<cl-list-item
					label="贷款管理"
					icon="money-cny-box-line"
					arrow
					hoverable
					@tap="toPage('/pages/loan/index')"
				></cl-list-item>

				<cl-list-item
					label="养老金管理"
					icon="shield-user-line"
					arrow
					hoverable
					@tap="toPage('/pages/pension/index')"
				></cl-list-item>
			</cl-list>

			<!-- 外观 -->
			<cl-list border title="外观" :pt="{ className: 'mt-4' }">
				<cl-list-item label="深色模式">
					<cl-switch v-model="darkOn"></cl-switch>
				</cl-list-item>
			</cl-list>

			<!-- 退出登录 -->
			<cl-button
				type="error"
				size="large"
				:pt="{ className: 'mt-8 !rounded-lg' }"
				@tap="onLogout"
			>
				退出登录
			</cl-button>
		</view>

		<CustomTabbar></CustomTabbar>
	</cl-page>
</template>

<script setup lang="ts">
import { getUser, removeToken, removeUser } from "@/api/request";
import { isDark, router, toggleTheme } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import { computed } from "vue";
import CustomTabbar from "./components/tabbar.uvue";

const ui = useUi();

// 深色模式开关
const darkOn = computed<boolean>({
	get() {
		return isDark.value;
	},

	set(v: boolean) {
		if (v != isDark.value) {
			toggleTheme();
		}
	}
});

// 用户名
const username = computed(() => {
	const u = getUser();
	return u?.username ?? "未登录";
});

// 跳转
function toPage(path: string) {
	router.push({ path });
}

// 退出登录
function onLogout() {
	ui.showConfirm({
		title: "提示",
		message: "确定要退出登录吗？",
		callback(action: string) {
			if (action == "confirm") {
				removeToken();
				removeUser();
				router.login();
			}
		}
	});
}
</script>
